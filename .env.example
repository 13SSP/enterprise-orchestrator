# ==============================================================================
# cortex.ai - Enterprise AI Orchestration Platform Configuration (.env.example)
# Google Cloud / Firebase Hackathon Stack
# ==============================================================================

# ------------------------------------------------------------------------------
# Google Cloud & Vertex AI Core Configuration
# ------------------------------------------------------------------------------
GCP_PROJECT_ID=cortex-ai-demo
GCP_REGION=us-central1
GOOGLE_APPLICATION_CREDENTIALS=

# Gemini API / Vertex AI Model Engine
GEMINI_API_KEY=your_gemini_api_key_here
DEFAULT_GEMINI_MODEL=gemini-2.5-flash

# Firebase / Firestore Local Emulator Configuration
# When set, the system communicates with local Firestore emulator on port 8080.
# If emulator is not running, falls back gracefully to database/firestore_storage/
FIRESTORE_EMULATOR_HOST=localhost:8080
FIREBASE_AUTH_EMULATOR_HOST=localhost:9099

# ------------------------------------------------------------------------------
# Cortex Orchestration Hub Backend Settings
# ------------------------------------------------------------------------------
CORTEX_HOST=127.0.0.1
CORTEX_PORT=8000
JWT_SECRET=super-secret-cortex-hackathon-key-2026-enterprise-orchestrator-jwt-token
AUDIT_LOG_COLLECTION=audit_logs

# Model Armor & Security Guardrails
# Screens incoming prompts against jailbreaks/prompt injection, and masks PII in outputs
MODEL_ARMOR_ENABLED=true

# Pluggable Enterprise RAG & OCR
VERTEX_SEARCH_ENABLED=false
DOCUMENT_AI_ENABLED=false

# ------------------------------------------------------------------------------
# Enterprise App Integration (Microsoft 365 Connector)
# ------------------------------------------------------------------------------
# M365_CONNECTOR_MODE: "MOCK" or "LIVE"
# In MOCK mode (default), real .docx and .pptx files are generated locally via python-docx/pptx
# and email drafts are saved to local storage with zero Azure Entra ID / Microsoft Graph prerequisites.
# In LIVE mode, requests route to Microsoft Graph via OAuth2 Client Credentials.
M365_CONNECTOR_MODE=MOCK
M365_CONNECTOR_URL=http://localhost:8005

# Microsoft Graph Credentials (only required if M365_CONNECTOR_MODE=LIVE)
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# ------------------------------------------------------------------------------
# External Model Gateway (Multi-Model Support)
# ------------------------------------------------------------------------------
# If left blank, cortex.ai uses the built-in OfflineStubProvider or Vertex Gemini fallback
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ------------------------------------------------------------------------------
# Domain Microservices Port Allocations (Internal Service-to-Service)
# ------------------------------------------------------------------------------
HR_API_URL=http://localhost:8001
PAYROLL_API_URL=http://localhost:8002
IT_SUPPORT_API_URL=http://localhost:8003
EXPENSE_API_URL=http://localhost:8004

# ------------------------------------------------------------------------------
# Domain Agents Port Allocations
# ------------------------------------------------------------------------------
HR_AGENT_URL=http://localhost:8011
FINANCE_AGENT_URL=http://localhost:8012
IT_SUPPORT_AGENT_URL=http://localhost:8013
OPS_AGENT_URL=http://localhost:8014
PRODUCTIVITY_AGENT_URL=http://localhost:8015

# ------------------------------------------------------------------------------
# Frontend Application Configuration
# ------------------------------------------------------------------------------
FRONTEND_PORT=4200
